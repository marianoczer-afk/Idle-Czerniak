{
  "name": "argentum-idle-online",
  "private": true,
  "scripts": {
    "dev": "npm run build && python3 -m http.server 8000 --bind 0.0.0.0",
    "test": "npm run test:full",
    "audit": "node scripts/audit-source.cjs",
    "build": "node scripts/build.cjs",
    "build:check": "node scripts/build.cjs --check",
    "assets:optimize": "python3 scripts/optimize-assets.py",
    "art:prepare": "node scripts/production-art.cjs",
    "art:gallery": "node scripts/build-art-gallery.cjs",
    "test:polish33": "node --test tests/polish33.test.cjs",
    "test:fishing34": "node --test tests/fishing34.test.cjs",
    "test:full": "node --test --test-concurrency=2 tests/*.test.cjs",
    "test:fast": "node --test --test-name-pattern=\"Generated single HTML|Gameplay engines|Source catalogues|Build profiling|Architecture inventory\" tests/build.test.cjs tests/workflow.test.cjs",
    "test:smoke": "node --test --test-name-pattern=\"regional capture|legacy credit\" tests/fishing34.test.cjs",
    "test:assets": "python3 tests/optimize-assets.test.py",
    "architecture:inventory": "node scripts/architecture-inventory.cjs",
    "build:profile": "node scripts/build.cjs --check --profile",
    "test:render": "node --test tests/render-equivalence.test.cjs"
  },
  "devDependencies": {
    "acorn": "8.15.0",
    "playwright": "1.58.2"
  }
}
